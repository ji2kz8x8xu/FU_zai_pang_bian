# 福在旁邊 - 配置文件範例
# 複製此檔案為 .env 並填入您的設定

# === API 金鑰 ===
# Google Gemini API 金鑰 (必填，用於 AI 聊天功能)
# 取得金鑰: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === AI 設定 ===
# AI 模型溫度 (0.0-1.0, 越高越有創意)
AI_TEMPERATURE=0.9

# 最大輸出 tokens
AI_MAX_TOKENS=1024

# === 其他設定 ===
# 是否在啟動時顯示歡迎訊息
SHOW_WELCOME=true

# 聊天記錄保存路徑 (可選)
# CHAT_HISTORY_PATH=./chat_history.json
